# ── 국가법령정보 Open API ──────────────────────────────
# https://open.law.go.kr 에서 신청 후 발급받은 OC(사용자 ID)
LAW_API_OC=
LAW_API_BASE_URL=https://www.law.go.kr/DRF
# 요청 간 최소 간격(초)
LAW_API_MIN_INTERVAL=0.2

# ── PostgreSQL (메타데이터 · 원문) ─────────────────────
DATABASE_URL=postgresql+psycopg://lawlens:lawlens@localhost:5432/lawlens

# ── Milvus Standalone ──────────────────────────────────
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default

# ── 임베딩 ─────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
DENSE_DIM=1024

# ── LLM ────────────────────────────────────────────────
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# ── Docker Compose ─────────────────────────────────────
# milvus-backup 컨테이너를 실행할 호스트 사용자 uid/gid (기본값 1000, `id -u` / `id -g` 로 확인)
# LAWLENS_UID=1000
# LAWLENS_GID=1000
